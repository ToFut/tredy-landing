# ElevenLabs. If ELEVENLABS_API_KEY is empty, the demo stays in preview mode.
ELEVENLABS_API_KEY=
# Premade receptionist voice. Production uses this id.
ELEVENLABS_DEFAULT_VOICE_ID=cgSgspJ2msm6clMCkdW9
# Premade caller voice. Production uses this id.
ELEVENLABS_CALLER_VOICE_ID=iP95p4xoKVk53GoZ742B
# eleven_flash_v2_5 or eleven_multilingual_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Script writing. Either key is enough. If both are empty, industry templates are used.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
OPENAI_API_KEY=

# Optional shared rate limit. Without these, limits are kept in memory on the server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lead email. Without RESEND_API_KEY, /api/book logs the request and still confirms on the page.
RESEND_API_KEY=
BOOK_FROM_EMAIL=

# Site analytics and Search Console. Loaded only when set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
